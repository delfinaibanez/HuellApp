<h1>
  <%= publicacion.tipo === 'perdido' ? 'Animal perdido' : 'Animal encontrado' %>
</h1>

<p><strong>Especie:</strong> <%= publicacion.especie %></p>
<% if (publicacion.raza) { %><p><strong>Raza:</strong> <%= publicacion.raza %></p><% } %>
<p><strong>Color:</strong> <%= publicacion.color %></p>
<p><strong>Tamaño:</strong> <%= publicacion.tamano %></p>
<p><strong>Descripción:</strong> <%= publicacion.descripcion %></p>
<% if (publicacion.rasgos) { %><p><strong>Rasgos:</strong> <%= publicacion.rasgos %></p><% } %>
<p><strong>Fecha:</strong> <%= publicacion.fechaEvento.toLocaleDateString('es-AR', { timeZone: 'UTC' }) %></p>
<p><strong>Zona:</strong> <%= publicacion.zona %></p>
<p><strong>Publicado por:</strong> <%= publicacion.usuario.nombre %></p>

<% if (publicacion.fotos.length > 0) { %>
  <section aria-label="Fotos de la publicación">
    <% publicacion.fotos.forEach((foto, indice) => { %>
      <img src="<%= foto %>" alt="Foto <%= indice + 1 %> del animal" width="320">
    <% }) %>
  </section>
<% } else { %>
  <p>Esta publicación no tiene fotos.</p>
<% } %>

<a href="/publicaciones">Ver todas las publicaciones</a>
