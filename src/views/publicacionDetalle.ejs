<%- include('partials/head', { titulo: 'Detalle' }) %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="tarjeta-blanca">

      <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <span class="etiqueta-tipo <%= publicacion.tipo === 'encontrado' ? 'encontrado' : '' %>">
          <%- include('partials/icono-tipo', { tipo: publicacion.tipo }) %>
          <%= publicacion.tipo === 'perdido' ? 'Perdido' : 'Encontrado' %>
        </span>
        <% if (publicacion.estado === 'resuelta') { %>
          <span class="badge text-bg-secondary">Resuelta</span>
        <% } %>
      </div>

      <h1 class="h3 fw-bold">
        <%= publicacion.especie.charAt(0).toUpperCase() + publicacion.especie.slice(1) %><%= publicacion.raza ? ' · ' + publicacion.raza : '' %>
      </h1>

      <% if (publicacion.fotos && publicacion.fotos.length > 0) { %>
        <div class="row g-3 my-2">
          <% publicacion.fotos.forEach((url) => { %>
            <div class="col-sm-6">
              <img src="<%= url %>" alt="Foto de la mascota" class="foto-detalle">
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-secondary">Esta publicación no tiene fotos.</p>
      <% } %>

      <dl class="row mt-3 mb-0">
        <dt class="col-sm-4">Color</dt><dd class="col-sm-8"><%= publicacion.color %></dd>
        <dt class="col-sm-4">Tamaño</dt><dd class="col-sm-8"><%= publicacion.tamano %></dd>
        <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8"><%= publicacion.descripcion %></dd>
        <% if (publicacion.rasgos) { %>
          <dt class="col-sm-4">Rasgos</dt><dd class="col-sm-8"><%= publicacion.rasgos %></dd>
        <% } %>
        <dt class="col-sm-4">Fecha</dt><dd class="col-sm-8"><%= publicacion.fechaEvento.toLocaleDateString('es-AR') %></dd>
        <dt class="col-sm-4">Zona</dt><dd class="col-sm-8"><%= publicacion.zona %></dd>
        <dt class="col-sm-4">Publicado por</dt><dd class="col-sm-8"><%= publicacion.usuario.nombre %></dd>
      </dl>

      <h2 class="h6 fw-bold mt-4 mb-1">Zona aproximada</h2>
      <p class="small mb-2">Por privacidad, el mapa muestra solo un área cercana y no el punto exacto.</p>
      <div id="mapa" class="mapa"></div>

      <div class="d-flex gap-2 flex-wrap mt-4">
        <a href="/publicaciones" class="btn btn-contorno">Volver al listado</a>
        <% if (esDueno && publicacion.estado === 'activa') { %>
          <form method="POST" action="/publicaciones/<%= publicacion._id %>/resolver" class="m-0">
            <button type="submit" class="btn btn-huellapp">Marcar como resuelta</button>
          </form>
        <% } %>
      </div>

    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  const zona = <%- JSON.stringify(zonaAprox) %>;
  const color = '<%= publicacion.tipo === "perdido" ? "#B84E0F" : "#2F7D4F" %>';

  const mapa = L.map('mapa', { scrollWheelZoom: false }).setView([zona.lat, zona.lng], 14);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 17,
    attribution: '&copy; OpenStreetMap',
  }).addTo(mapa);

  L.circle([zona.lat, zona.lng], {
    radius: 500,
    color: color,
    fillColor: color,
    fillOpacity: 0.25,
  }).addTo(mapa);
</script>

<%- include('partials/foot') %>