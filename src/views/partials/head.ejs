<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' | HuellApp' : 'HuellApp' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-huellapp">
  <div class="container">
    <a class="navbar-brand" href="/">HuellApp</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-label="Abrir menú">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuPrincipal">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/publicaciones">Publicaciones</a></li>
        <% if (usuario) { %>
          <li class="nav-item"><a class="nav-link" href="/publicaciones/nueva">Nueva publicación</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav align-items-lg-center gap-lg-3">
        <% if (usuario) { %>
          <li class="nav-item">
            <a class="nav-link" href="/notificaciones">
              Notificaciones
                <% if (locals.noLeidas > 0) { %>
                <span class="badge rounded-pill bg-danger"><%= noLeidas %></span>
              <% } %>
            </a>
          </li>
          <li class="nav-item"><span class="navbar-text fw-bold">Hola, <%= usuario.nombre %></span></li>
          <li class="nav-item">
            <form method="POST" action="/logout" class="m-0">
              <button type="submit" class="btn btn-contorno btn-sm">Salir</button>
            </form>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login">Entrar</a></li>
          <li class="nav-item"><a class="btn btn-huellapp btn-sm" href="/registro">Registrarme</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main class="container py-4 flex-grow-1">
  <% if (locals.error) { %>
    <div class="alert alert-danger" role="alert"><%= error %></div>
  <% } %>