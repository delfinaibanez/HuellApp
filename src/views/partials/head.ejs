<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' | HuellApp' : 'HuellApp' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/huellapp-favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-huellapp">
  <div class="container">
    <a class="logo-huella" href="/">
      <span class="logo-circulo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="5.5" cy="11" rx="2" ry="2.8"/><ellipse cx="9.5" cy="6" rx="2" ry="2.8"/><ellipse cx="14.5" cy="6" rx="2" ry="2.8"/><ellipse cx="18.5" cy="11" rx="2" ry="2.8"/><path d="M12 11.5c-3 0-5.5 3-5.5 5.8 0 1.9 1.4 2.9 2.9 2.9 1 0 1.7-.5 2.6-.5s1.6.5 2.6.5c1.5 0 2.9-1 2.9-2.9 0-2.8-2.5-5.8-5.5-5.8z"/></svg>
      </span>
      HuellApp
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-label="Abrir menú">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuPrincipal">
      <ul class="navbar-nav me-auto ms-lg-4">
        <% if (!usuario) { %>
          <li class="nav-item"><a class="nav-link navbar-enlace" href="/#como-funciona">Cómo funciona</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link navbar-enlace" href="/publicaciones">Mascotas</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav align-items-lg-center gap-lg-2 navbar-acciones">
        <% if (usuario) { %>
          <li class="nav-item">
            <a class="btn btn-huellapp btn-sm navbar-accion-principal" href="/publicaciones/nueva">Publicar</a>
          </li>
          <li class="nav-item">
            <a class="nav-link campana navbar-campana" href="/notificaciones" aria-label="Notificaciones">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z"/><path d="M10 21h4"/></svg>
              <% if (locals.noLeidas > 0) { %>
                <span class="contador-campana" id="contador-campana"><%= noLeidas %></span>
              <% } %>
            </a>
          </li>
          <li class="nav-item dropdown">
            <button class="btn-usuario navbar-usuario dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="avatar"><%= usuario.nombre.charAt(0).toUpperCase() %></span>
              <%= usuario.nombre %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/perfil">Mi perfil</a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="POST" action="/logout" class="m-0">
                  <button type="submit" class="dropdown-item">Salir</button>
                </form>
              </li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link navbar-enlace" href="/login">Ya tengo cuenta</a></li>
          <li class="nav-item"><a class="btn btn-huellapp btn-sm navbar-accion-principal" href="/registro">Sumarme</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<% const anchoCompleto = typeof completo !== 'undefined' && completo; %>
<main class="<%= anchoCompleto ? '' : 'container py-4' %> flex-grow-1">
  <% if (locals.error) { %>
    <% if (anchoCompleto) { %><div class="container pt-3"><% } %>
    <div class="alert alert-danger" role="alert"><%= error %></div>
    <% if (anchoCompleto) { %></div><% } %>
  <% } %>