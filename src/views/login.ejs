<%- include('partials/head', { titulo: 'Entrar' }) %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-5">
    <div class="tarjeta-blanca">
      <h1 class="h3 fw-bold mb-1">Bienvenida de nuevo</h1>
      <p class="mb-4">Entrá para publicar o revisar tus avisos.</p>

      <form method="POST" action="/login">
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" name="email" required>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Contraseña</label>
          <input type="password" class="form-control" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-huellapp w-100">Entrar</button>
      </form>

      <p class="text-center mt-3 mb-0">
        ¿No tenés cuenta? <a href="/registro" class="enlace-huellapp">Registrate</a>
      </p>
    </div>
  </div>
</div>

<%- include('partials/foot') %>