<%- include('../partials/head', { titulo: 'Notificaciones' }) %>

<section class="notificaciones-pagina">
  <header class="notificaciones-encabezado">
    <div>
      <span class="notificaciones-sello">Tu actividad en HuellApp</span>
      <h1>Notificaciones</h1>
      <p>Acá vas a encontrar novedades y posibles coincidencias para revisar.</p>
    </div>
    <div class="notificaciones-resumen" aria-live="polite">
      <span class="notificaciones-resumen-numero" id="notificaciones-no-leidas"><%= noLeidas %></span>
      <span><%= noLeidas === 1 ? 'notificación sin leer' : 'notificaciones sin leer' %></span>
    </div>
  </header>

  <div class="notificaciones-listado-cabecera">
    <div>
      <h2>Novedades recientes</h2>
      <p>Las más nuevas aparecen primero.</p>
    </div>
    <form method="POST" action="/notificaciones/leer-todas" class="m-0" id="notificaciones-marcar-todas-form" <%= noLeidas === 0 ? 'hidden' : '' %>>
      <button type="submit" class="btn btn-contorno btn-sm">Marcar todas como leídas</button>
    </form>
  </div>

  <div class="notificaciones-lista" id="lista-notificaciones" aria-live="polite">
    <% if (notificaciones.length === 0) { %>
      <div class="notificaciones-vacias" id="sin-notificaciones">
        <span class="notificaciones-vacias-icono" aria-hidden="true">♡</span>
        <h2>Por ahora, todo tranquilo</h2>
        <p>Cuando haya novedades o una posible coincidencia, te avisamos acá.</p>
        <a href="/publicaciones" class="btn btn-huellapp">Explorar mascotas</a>
      </div>
    <% } else { %>
      <% notificaciones.forEach((n) => { %>
        <article class="notificacion <%= n.leida ? '' : 'nueva' %>" data-notificacion-id="<%= n._id %>">
          <span class="notificacion-icono <%= n.coincidencia ? 'es-coincidencia' : '' %>" aria-hidden="true">
            <%= n.coincidencia ? '↗' : '•' %>
          </span>
          <div class="notificacion-cuerpo">
            <div class="notificacion-etiquetas">
              <span class="notificacion-estado <%= n.leida ? 'leida' : 'pendiente' %>">
                <%= n.leida ? 'Leída' : 'Nueva' %>
              </span>
              <% if (n.coincidencia) { %>
                <span class="notificacion-tipo">Posible coincidencia</span>
              <% } %>
            </div>
            <p class="notificacion-mensaje"><%= n.mensaje %></p>
            <time class="notificacion-fecha" datetime="<%= n.createdAt.toISOString() %>"><%= n.createdAt.toLocaleString('es-AR') %></time>
          </div>
          <div class="notificacion-acciones">
            <% if (n.coincidencia) { %>
              <a href="/coincidencias/<%= n.coincidencia._id %>" class="btn btn-huellapp btn-sm">Ver coincidencia <span aria-hidden="true">→</span></a>
            <% } %>
            <% if (!n.leida) { %>
              <form method="POST" action="/notificaciones/<%= n._id %>/leer" class="m-0">
                <button type="submit" class="btn btn-contorno btn-sm">Marcar leída</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>

<%- include('../partials/foot') %>
